# generated data (recreate with gen_test_image.py / layout_mosaic.py /
# build_pyramid.py / export_dzi.py)
*.npy
*_pyramid/
*_dzi/
*_preview.png
*_layout.json
*_web/
shot_*.png

# web build output (c/build_web.sh), and the local tiles link
web/vt_sphere_viewer.js
web/vt_sphere_viewer.wasm
web/tiles

# Pixabay forbids redistributing its content on a standalone basis, so
# those downloads stay out of git. Unsplash/Pexels sets (photos_*/) may
# be committed — their licences permit it.
pixabay_*/

# the synthetic card tree is regenerated byte-for-byte by
# gen_test_image_tree.py, so there is nothing to gain from storing it
pics/phototree/

# python
__pycache__/
.venv/

# C build artifacts
c/*.o
c/vt_viewer
c/vt_sphere_viewer
c/*.dSYM/

# macOS
.DS_Store
.claude/
